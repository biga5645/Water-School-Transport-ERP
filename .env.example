# ==============================================================
# Environment Configuration — Association ERP
# Copy this file to .env and configure for your local/server setup.
# ==============================================================

# Server Port
PORT=5173

# App Secret Key for HMAC-SHA256 Token Signing (minimum 32 characters)
APP_SECRET=change_this_to_a_secure_random_hex_key_32_characters_minimum

# Database Connection (MySQL / MariaDB via XAMPP or Remote Server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=association
